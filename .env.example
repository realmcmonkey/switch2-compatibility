# Frontend: public URL of the deployed API, without a trailing slash
VITE_API_URL=https://your-project.vercel.app
# Backend only (set in Vercel, never use a VITE_ prefix)
DATABASE_URL=mysql://user:password@host:4000/database
DATABASE_SSL=true
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://your-project.vercel.app/api/auth/callback
ADMIN_DISCORD_ID=
FRONTEND_URL=https://realmcmonkey.github.io/switch2-compatibility/
NODE_ENV=production
